server {
    listen 80;
    server_name geovp.ru www.geovp.ru;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name geovp.ru www.geovp.ru;

    ssl_certificate /etc/letsencrypt/live/geovp.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/geovp.ru/privkey.pem;

    # 1. API
    location /api/ {
        proxy_pass http://vpn-api-gateway:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

	proxy_set_header X-Internal-Secret "${INTERNAL_SECRET}";
        proxy_set_header X-User-Id "${ADMIN_TELEGRAM_ID}";
    }

    # 2. Admin Panel
    location /admin/ {
        proxy_pass http://vpn-admin-panel:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Mini App
    location / {
        proxy_pass http://vpn-mini-app:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
